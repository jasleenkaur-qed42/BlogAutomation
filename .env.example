# Copy to .env (gitignored) and fill in. Never commit real values.
SLACK_BOT_TOKEN=xoxb-...
# Google OAuth (Desktop app client). Run mcp_servers/drive_auth.py once to create the token file.
GOOGLE_OAUTH_CLIENT_FILE=secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/google-token.json
# Image generation (claude-image-gen MCP, Gemini). Used for every ai_image visual.
GEMINI_API_KEY=
# Optional: GEMINI_DEFAULT_MODEL=gemini-3-pro-image-preview
