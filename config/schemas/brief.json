{
 "type": "object",
 "required": [
  "topic",
  "audience",
  "primary_keyword",
  "tone"
 ],
 "properties": {
  "topic": {
   "type": "string",
   "minLength": 3
  },
  "audience": {
   "oneOf": [
    {
     "type": "string",
     "minLength": 3
    },
    {
     "type": "object",
     "required": [
      "primary"
     ],
     "properties": {
      "primary": {
       "type": "string",
       "minLength": 3
      },
      "experience_level": {
       "type": "string"
      }
     }
    }
   ]
  },
  "primary_keyword": {
   "type": "string",
   "minLength": 2
  },
  "secondary_keywords": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "tone": {
   "type": "string"
  },
  "target_words": {
   "type": "object",
   "required": [
    "min",
    "max"
   ],
   "properties": {
    "min": {
     "type": "integer",
     "minimum": 1
    },
    "max": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "images": {
   "type": "object",
   "properties": {
    "min": {
     "type": "integer",
     "minimum": 0,
     "maximum": 6
    }
   }
  },
  "visuals": {
   "type": "object",
   "properties": {
    "min": {
     "type": "integer",
     "minimum": 0,
     "maximum": 8
    },
    "max": {
     "type": "integer",
     "minimum": 0,
     "maximum": 8
    },
    "image_source": {
     "enum": [
      "gemini",
      "prompt"
     ]
    }
   }
  },
  "must_include": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "must_avoid": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "content_type": {
   "type": "string"
  },
  "purpose": {
   "type": "string"
  },
  "technical_depth": {
   "type": "string"
  },
  "original_angle": {
   "type": [
    "string",
    "null"
   ]
  },
  "references": {
   "type": "object",
   "properties": {
    "required": {
     "type": "boolean"
    },
    "preferred_sources": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "reader_takeaway": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "examples": {
   "type": "object",
   "properties": {
    "preferred": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "include_code": {
     "type": "boolean"
    }
   }
  },
  "audience_type": {
   "enum": [
    "community",
    "cto",
    "business"
   ]
  },
  "mode": {
   "enum": [
    "create",
    "improve"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "kind",
    "ref"
   ],
   "properties": {
    "kind": {
     "enum": [
      "local",
      "gdoc"
     ]
    },
    "ref": {
     "type": "string",
     "minLength": 1
    }
   }
  },
  "goal": {
   "oneOf": [
    {
     "type": "string",
     "minLength": 3
    },
    {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 2
     }
    }
   ]
  },
  "keep": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 }
}
